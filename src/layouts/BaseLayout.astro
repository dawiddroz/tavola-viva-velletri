---
import '../styles/global.css';
import '../styles/navbar.css';
import '../styles/sections.css';

const businessName = "Tavola viva";
const businessFull = "Tavola viva di Federico Bastianelli";

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Tavola viva di Federico Bastianelli | Ristorante a Velletri",
  description = "Ristorante intimo nel cuore di Velletri. Cucina tradizionale italiana reinterpretata con creatività. Ingredienti freschi e stagionali. Prenota direttamente.",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />

  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="restaurant" />
  <meta property="og:locale" content="it_IT" />

  <!-- Google Fonts: Playfair Display + Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Leaflet CSS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

  <!-- Structured Data: Restaurant -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Restaurant",
    "name": businessFull,
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Via del Comune, 22",
      "addressLocality": "Velletri",
      "postalCode": "00049",
      "addressRegion": "RM",
      "addressCountry": "IT"
    },
    "telephone": "+393464144878",
    "priceRange": "€€",
    "servesCuisine": "Italian",
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "reviewCount": "27"
    }
  })} />

  <!-- No-JS fallback: show all content if JS disabled -->
  <noscript>
    <style>
      .reveal, .hero__eyebrow, .hero__title, .hero__subtitle, .hero__actions,
      .hero__actions .btn, .menu__card, .gallery__item, .review-card,
      .instagram-banner__card { opacity: 1 !important; transform: none !important; }
    </style>
  </noscript>
</head>
<body>
  <!-- Progress bar -->
  <div class="progress-bar" aria-hidden="true"></div>

  <slot />

  <!-- GSAP + ScrollTrigger via CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer></script>

  <!-- Leaflet JS -->
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" defer></script>

  <!-- Lenis via CDN -->
  <script src="https://cdn.jsdelivr.net/npm/lenis@1.3.13/dist/lenis.min.js" defer></script>

  <!-- Site animations — bulletproof: content visible by default, JS only enhances -->
  <script>
    // ===== Counter animation (no dependencies, runs immediately) =====
    function initCounters() {
      document.querySelectorAll('[data-counter]').forEach(el => {
        const target = parseFloat(el.dataset.counter);
        const decimals = el.dataset.decimals ? parseInt(el.dataset.decimals) : 0;
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const start = performance.now();
              const duration = 2000;
              function tick() {
                const elapsed = performance.now() - start;
                const progress = Math.min(elapsed / duration, 1);
                const easeOut = 1 - Math.pow(1 - progress, 3);
                const value = target * easeOut;
                el.textContent = decimals > 0 ? value.toFixed(decimals) : Math.round(value);
                if (progress < 1) requestAnimationFrame(tick);
              }
              tick();
              observer.unobserve(el);
            }
          });
        }, { threshold: 0.5 });
        observer.observe(el);
      });
    }

    // ===== Mobile menu toggle (no dependencies) =====
    function initMobileMenu() {
      const toggle = document.querySelector('.navbar__toggle');
      const mobileMenu = document.querySelector('.mobile-menu');
      if (toggle && mobileMenu) {
        toggle.addEventListener('click', () => {
          toggle.classList.toggle('active');
          mobileMenu.classList.toggle('active');
          document.body.style.overflow = mobileMenu.classList.contains('active') ? 'hidden' : '';
        });
        mobileMenu.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', () => {
            toggle.classList.remove('active');
            mobileMenu.classList.remove('active');
            document.body.style.overflow = '';
          });
        });
      }
    }

    // ===== Contact form (no dependencies) =====
    function initForm() {
      const form = document.getElementById('contact-form');
      if (form) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const name = form.querySelector('[name="name"]')?.value || '';
          const phone = form.querySelector('[name="phone"]')?.value || '';
          const date = form.querySelector('[name="date"]')?.value || '';
          const guests = form.querySelector('[name="guests"]')?.value || '';
          const message = form.querySelector('[name="message"]')?.value || '';

          let waMsg = `Prenotazione Tavola viva:%0A%0A`;
          waMsg += `Nome: ${name}%0A`;
          if (phone) waMsg += `Telefono: ${phone}%0A`;
          if (date) waMsg += `Data: ${date}%0A`;
          if (guests) waMsg += `Persone: ${guests}%0A`;
          if (message) waMsg += `Messaggio: ${message}%0A`;

          window.open(`https://wa.me/393464144878?text=${waMsg}`, '_blank');

          const notice = form.querySelector('.form__notice');
          if (notice) {
            notice.classList.add('success');
            notice.textContent = 'Ti stiamo reindirizzando a WhatsApp per completare la prenotazione...';
          }
          form.reset();
        });
      }
    }

    // ===== Lightbox (no dependencies) =====
    function initLightbox() {
      const lightbox = document.querySelector('.lightbox');
      const lightboxImg = document.querySelector('.lightbox__img');
      const lightboxClose = document.querySelector('.lightbox__close');

      document.querySelectorAll('.gallery__item').forEach(item => {
        item.addEventListener('click', () => {
          const img = item.querySelector('img');
          if (img && lightbox && lightboxImg) {
            lightboxImg.src = img.src;
            lightbox.classList.add('active');
          }
        });
      });

      if (lightboxClose && lightbox) {
        lightboxClose.addEventListener('click', () => lightbox.classList.remove('active'));
        lightbox.addEventListener('click', (e) => {
          if (e.target === lightbox) lightbox.classList.remove('active');
        });
      }
    }

    // ===== Leaflet map (depends on Leaflet) =====
    function initMap() {
      if (typeof L === 'undefined') return;
      const mapEl = document.getElementById('map');
      if (!mapEl) return;

      const map = L.map('map', {
        scrollWheelZoom: false,
        zoomControl: true
      }).setView([41.6876185, 12.7781205], 16);

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors',
        maxZoom: 19
      }).addTo(map);

      const marker = L.marker([41.6876185, 12.7781205]).addTo(map);
      marker.bindPopup('<strong>Tavola viva di Federico Bastianelli</strong><br>Via del Comune, 22, 00049 Velletri RM<br>Tel: 346 414 4878').openPopup();

      mapEl.addEventListener('click', () => map.scrollWheelZoom.enable());
    }

    // ===== GSAP animations (depends on GSAP + ScrollTrigger) =====
    function initGSAP() {
      if (typeof gsap === 'undefined') return;
      if (typeof ScrollTrigger !== 'undefined') {
        gsap.registerPlugin(ScrollTrigger);
      }

      // Smooth scroll (Lenis)
      if (typeof Lenis !== 'undefined') {
        const lenis = new Lenis({ duration: 1.2, smoothWheel: true });
        function raf(time) { lenis.raf(time); requestAnimationFrame(raf); }
        requestAnimationFrame(raf);
        if (typeof ScrollTrigger !== 'undefined') {
          lenis.on('scroll', ScrollTrigger.update);
        }
      }

      // Navbar scroll state
      if (typeof ScrollTrigger !== 'undefined') {
        ScrollTrigger.create({
          start: 'top -100',
          onEnter: () => document.querySelector('.navbar')?.classList.add('scrolled'),
          onLeaveBack: () => document.querySelector('.navbar')?.classList.remove('scrolled')
        });

        // Progress bar
        gsap.to('.progress-bar', {
          scaleX: 1,
          transformOrigin: 'left center',
          ease: 'none',
          scrollTrigger: {
            trigger: document.body,
            start: 'top top',
            end: 'bottom bottom',
            scrub: 0.5
          }
        });
      }

      // Hero animations — handled by CSS @keyframes (no flash, no dependency)

      // Scroll reveal — uses onEnter so elements are visible by default
      if (typeof ScrollTrigger !== 'undefined') {
        // Generic reveal
        gsap.utils.toArray('.reveal').forEach(el => {
          if (el.closest('#hero')) return;
          ScrollTrigger.create({
            trigger: el,
            start: 'top 85%',
            onEnter: () => {
              gsap.fromTo(el, { opacity: 0, y: 40 }, { opacity: 1, y: 0, duration: 0.7, ease: 'power2.out' });
            },
            onLeaveBack: () => {
              gsap.set(el, { opacity: 1, y: 0 });
            }
          });
        });

        // Menu stagger
        ScrollTrigger.create({
          trigger: '.menu__grid',
          start: 'top 80%',
          onEnter: () => {
            gsap.fromTo('.menu__card', { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.5, stagger: 0.12, ease: 'power2.out' });
          }
        });

        // Gallery stagger
        ScrollTrigger.create({
          trigger: '.gallery__grid',
          start: 'top 80%',
          onEnter: () => {
            gsap.fromTo('.gallery__item', { opacity: 0, scale: 0.8 }, { opacity: 1, scale: 1, duration: 0.5, stagger: 0.08, ease: 'power2.out' });
          }
        });

        // Review stagger
        ScrollTrigger.create({
          trigger: '.reviews__grid',
          start: 'top 80%',
          onEnter: () => {
            gsap.fromTo('.review-card', { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.5, stagger: 0.1, ease: 'power2.out' });
          }
        });

        ScrollTrigger.refresh();
      }
    }

    // ===== Run everything on DOMContentLoaded (don't wait for images) =====
    document.addEventListener('DOMContentLoaded', () => {
      // These run immediately — no dependencies
      initCounters();
      initMobileMenu();
      initForm();
      initLightbox();
      initMap();

      // GSAP runs after a tiny delay to ensure CDN scripts are ready
      setTimeout(initGSAP, 100);

      // Safety net: if GSAP hasn't fired after 4s, show everything
      setTimeout(() => {
        const els = document.querySelectorAll('.reveal, .hero__eyebrow, .hero__title, .hero__subtitle, .hero__actions, .hero__actions .btn, .menu__card, .gallery__item, .review-card, .instagram-banner__card');
        els.forEach(el => { el.style.opacity = '1'; el.style.transform = 'none'; });
      }, 4000);
    });
  </script>
</body>
</html>
