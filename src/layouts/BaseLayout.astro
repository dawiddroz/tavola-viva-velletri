1|---
2|import '../styles/global.css';
3|import '../styles/navbar.css';
4|import '../styles/sections.css';
5|
6|const businessName = "Tavola viva";
7|const businessFull = "Tavola viva di Federico Bastianelli";
8|
9|export interface Props {
10|  title?: string;
11|  description?: string;
12|}
13|
14|const {
15|  title = "Tavola viva di Federico Bastianelli | Ristorante a Velletri",
16|  description = "Ristorante intimo nel cuore di Velletri. Cucina tradizionale italiana reinterpretata con creatività. Ingredienti freschi e stagionali. Prenota direttamente.",
17|} = Astro.props;
18|---
19|
20|<!DOCTYPE html>
21|<html lang="it">
22|<head>
23|  <meta charset="UTF-8" />
24|  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
25|  <meta name="generator" content={Astro.generator} />
26|
27|  <title>{title}</title>
28|  <meta name="description" content={description} />
29|
30|  <!-- Open Graph -->
31|  <meta property="og:title" content={title} />
32|  <meta property="og:description" content={description} />
33|  <meta property="og:type" content="restaurant" />
34|  <meta property="og:locale" content="it_IT" />
35|
36|  <!-- Google Fonts: Playfair Display + Inter -->
37|  <link rel="preconnect" href="https://fonts.googleapis.com" />
38|  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
39|  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet" />
40|
41|  <!-- Leaflet CSS -->
42|  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
43|
44|  <!-- Structured Data: Restaurant -->
45|  <script type="application/ld+json" set:html={JSON.stringify({
46|    "@context": "https://schema.org",
47|    "@type": "Restaurant",
48|    "name": businessFull,
49|    "address": {
50|      "@type": "PostalAddress",
51|      "streetAddress": "Via del Comune, 22",
52|      "addressLocality": "Velletri",
53|      "postalCode": "00049",
54|      "addressRegion": "RM",
55|      "addressCountry": "IT"
56|    },
57|    "telephone": "+393****4878",
58|    "priceRange": "€€",
59|    "servesCuisine": "Italian",
60|    "aggregateRating": {
61|      "@type": "AggregateRating",
62|      "ratingValue": "4.9",
63|      "reviewCount": "27"
64|    }
65|  })} />
66|</head>
67|<body>
68|  <!-- Progress bar -->
69|  <div class="progress-bar" aria-hidden="true"></div>
70|
71|  <slot />
72|
73|  <!-- GSAP + ScrollTrigger via CDN -->
74|  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
75|  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer></script>
76|
77|  <!-- Leaflet JS -->
78|  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" defer></script>
79|
80|  <!-- Site animations -->
81|  <script type="module">
82|    // Wait for everything to load
83|    window.addEventListener('load', () => {
84|85|
86|      // ===== Smooth scroll (Lenis-like via requestAnimationFrame) =====
87|      if (typeof Lenis !== 'undefined') {
88|        const lenis = new Lenis({ duration: 1.2, smoothWheel: true });
89|        function raf(time) { lenis.raf(time); requestAnimationFrame(raf); }
90|        requestAnimationFrame(raf);
91|        if (typeof ScrollTrigger !== 'undefined') {
92|          lenis.on('scroll', ScrollTrigger.update);
93|        }
94|      }
95|
96|      // ===== Guard: GSAP must be loaded =====
97|      if (typeof gsap === 'undefined') return;
98|
99|      if (typeof ScrollTrigger !== 'undefined') {
100|        gsap.registerPlugin(ScrollTrigger);
101|      }
102|
103|      // ===== Scroll Reveal =====
104|      if (!prefersReduced) {
105|        gsap.utils.toArray('.reveal').forEach(el => {
106|          // Skip hero elements (they have dedicated animations)
107|          if (el.closest('#hero')) return;
108|          gsap.from(el, {
109|            scrollTrigger: { trigger: el, start: 'top 85%' },
110|            y: 40, opacity: 0, duration: 0.7, ease: 'power2.out'
111|          });
112|        });
113|      }
114|
115|      // ===== Navbar scroll state =====
116|      if (typeof ScrollTrigger !== 'undefined') {
117|        ScrollTrigger.create({
118|          start: 'top -100',
119|          onEnter: () => document.querySelector('.navbar')?.classList.add('scrolled'),
120|          onLeaveBack: () => document.querySelector('.navbar')?.classList.remove('scrolled')
121|        });
122|      }
123|
124|      // ===== Progress bar =====
125|      gsap.to('.progress-bar', {
126|        scaleX: 1,
127|        transformOrigin: 'left center',
128|        ease: 'none',
129|        scrollTrigger: {
130|          trigger: document.body,
131|          start: 'top top',
132|          end: 'bottom bottom',
133|          scrub: 0.5
134|        }
135|      });
136|
137|      // ===== Hero mask reveal =====
138|      if (!prefersReduced) {
139|        const heroTitle = document.querySelector('.hero__title');
140|        if (heroTitle) {
141|          gsap.from(heroTitle, {
142|            yPercent: 100,
143|            opacity: 0,
144|            duration: 1.2,
145|            ease: 'power4.out',
146|            delay: 0.3
147|          });
148|        }
149|        const heroEyebrow = document.querySelector('.hero__eyebrow');
150|        if (heroEyebrow) {
151|          gsap.from(heroEyebrow, { y: 20, opacity: 0, duration: 0.8, delay: 0.1 });
152|        }
153|        const heroSubtitle = document.querySelector('.hero__subtitle');
154|        if (heroSubtitle) {
155|          gsap.from(heroSubtitle, { y: 20, opacity: 0, duration: 0.8, delay: 0.5 });
156|        }
157|        const heroActions = document.querySelectorAll('.hero__actions .btn');
158|        if (heroActions.length) {
159|          gsap.from(heroActions, { y: 20, opacity: 0, duration: 0.6, stagger: 0.1, delay: 0.7 });
160|        }
161|      }
162|
163|      // ===== Menu stagger =====
164|      if (typeof ScrollTrigger !== 'undefined') {
165|        gsap.from('.menu__card', {
166|          scrollTrigger: { trigger: '.menu__grid', start: 'top 80%' },
167|          y: 30, opacity: 0, duration: 0.5, stagger: 0.12, ease: 'power2.out'
168|        });
169|      }
170|
171|      // ===== Gallery stagger =====
172|      if (typeof ScrollTrigger !== 'undefined') {
173|        gsap.from('.gallery__item', {
174|          scrollTrigger: { trigger: '.gallery__grid', start: 'top 80%' },
175|          scale: 0.8, opacity: 0, duration: 0.5, stagger: 0.08, ease: 'power2.out'
176|        });
177|      }
178|
179|      // ===== Review cards stagger =====
180|      if (typeof ScrollTrigger !== 'undefined') {
181|        gsap.from('.review-card', {
182|          scrollTrigger: { trigger: '.reviews__grid', start: 'top 80%' },
183|          y: 30, opacity: 0, duration: 0.5, stagger: 0.1, ease: 'power2.out'
184|        });
185|      }
186|
187|      // ===== Counter animation (independent of GSAP) =====
188|      document.querySelectorAll('[data-counter]').forEach(el => {
189|        const target = parseFloat(el.dataset.counter);
190|        const decimals = el.dataset.decimals ? parseInt(el.dataset.decimals) : 0;
191|        const observer = new IntersectionObserver((entries) => {
192|          entries.forEach(entry => {
193|            if (entry.isIntersecting) {
194|              const start = performance.now();
195|              const duration = 2000;
196|              function tick() {
197|                const elapsed = performance.now() - start;
198|                const progress = Math.min(elapsed / duration, 1);
199|                const easeOut = 1 - Math.pow(1 - progress, 3);
200|                const value = target * easeOut;
201|                el.textContent = decimals > 0 ? value.toFixed(decimals) : Math.round(value);
202|                if (progress < 1) requestAnimationFrame(tick);
203|              }
204|              tick();
205|              observer.unobserve(el);
206|            }
207|          });
208|        }, { threshold: 0.5 });
209|        observer.observe(el);
210|      });
211|
212|      // ===== Mobile menu toggle =====
213|      const toggle = document.querySelector('.navbar__toggle');
214|      const mobileMenu = document.querySelector('.mobile-menu');
215|      if (toggle && mobileMenu) {
216|        toggle.addEventListener('click', () => {
217|          toggle.classList.toggle('active');
218|          mobileMenu.classList.toggle('active');
219|          document.body.style.overflow = mobileMenu.classList.contains('active') ? 'hidden' : '';
220|        });
221|        mobileMenu.querySelectorAll('a').forEach(link => {
222|          link.addEventListener('click', () => {
223|            toggle.classList.remove('active');
224|            mobileMenu.classList.remove('active');
225|            document.body.style.overflow = '';
226|          });
227|        });
228|      }
229|
230|      // ===== Leaflet map =====
231|      if (typeof L !== 'undefined') {
232|        const mapEl = document.getElementById('map');
233|        if (mapEl) {
234|          const map = L.map('map', {
235|            scrollWheelZoom: false,
236|            zoomControl: true
237|          }).setView([41.6876185, 12.7781205], 16);
238|
239|          L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
240|            attribution: '&copy; OpenStreetMap contributors',
241|            maxZoom: 19
242|          }).addTo(map);
243|
244|          const marker = L.marker([41.6876185, 12.7781205]).addTo(map);
245|          marker.bindPopup('<strong>Tavola viva di Federico Bastianelli</strong><br>Via del Comune, 22, 00049 Velletri RM<br>Tel: 346 414 4878').openPopup();
246|
247|          // Enable scroll zoom on click
248|          mapEl.addEventListener('click', () => map.scrollWheelZoom.enable());
249|        }
250|      }
251|
252|      // ===== Contact form (WhatsApp redirect) =====
253|      const form = document.getElementById('contact-form');
254|      if (form) {
255|        form.addEventListener('submit', (e) => {
256|          e.preventDefault();
257|          const name = form.querySelector('[name="name"]')?.value || '';
258|          const phone = form.querySelector('[name="phone"]')?.value || '';
259|          const date = form.querySelector('[name="date"]')?.value || '';
260|          const guests = form.querySelector('[name="guests"]')?.value || '';
261|          const message = form.querySelector('[name="message"]')?.value || '';
262|
263|          let waMsg = `Prenotazione Tavola viva:%0A%0A`;
264|          waMsg += `Nome: ${name}%0A`;
265|          if (phone) waMsg += `Telefono: ${phone}%0A`;
266|          if (date) waMsg += `Data: ${date}%0A`;
267|          if (guests) waMsg += `Persone: ${guests}%0A`;
268|          if (message) waMsg += `Messaggio: ${message}%0A`;
269|
270|          window.open(`https://wa.me/393464144878?text=${waMsg}`, '_blank');
271|
272|          const notice = form.querySelector('.form__notice');
273|          if (notice) {
274|            notice.classList.add('success');
275|            notice.textContent = 'Ti stiamo reindirizzando a WhatsApp per completare la prenotazione...';
276|          }
277|          form.reset();
278|        });
279|      }
280|
281|      // ===== Lightbox =====
282|      const lightbox = document.querySelector('.lightbox');
283|      const lightboxImg = document.querySelector('.lightbox__img');
284|      const lightboxClose = document.querySelector('.lightbox__close');
285|
286|      document.querySelectorAll('.gallery__item').forEach(item => {
287|        item.addEventListener('click', () => {
288|          const bg = item.querySelector('.gallery__item-inner');
289|          if (bg && lightbox && lightboxImg) {
290|            lightboxImg.src = bg.style.backgroundImage.slice(5, -2).replace(/^["']|["']$/g, '');
291|            lightbox.classList.add('active');
292|          }
293|        });
294|      });
295|
296|      if (lightboxClose && lightbox) {
297|        lightboxClose.addEventListener('click', () => lightbox.classList.remove('active'));
298|        lightbox.addEventListener('click', (e) => {
299|          if (e.target === lightbox) lightbox.classList.remove('active');
300|        });
301|      }
302|
303|      // ===== ScrollTrigger refresh after images load =====
304|      if (typeof ScrollTrigger !== 'undefined') {
305|        ScrollTrigger.refresh();
306|      }
307|    });
308|  </script>
309|
310|  <!-- Lenis via CDN (before module script) -->
311|  <script src="https://cdn.jsdelivr.net/npm/lenis@1.3.13/dist/lenis.min.js" defer></script>
312|</body>
313|</html>
314|